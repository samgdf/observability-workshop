# Copy to .env and fill in. The app loads this via python-dotenv (load_dotenv()).

# --- OpenAI (same values the workshop 18 app uses) ---
OPENAI_API_KEY="your-openai-api-key"
OPENAI_BASE_URL="https://lite-llm-proxy.splunko11y.com/v1"
# Optional: override the model. Defaults to gpt-4.1-mini.
# OPENAI_MODEL_NAME="gpt-4.1-mini"

# --- Galileo ---
GALILEO_API_KEY="your-galileo-api-key"
GALILEO_CONSOLE_URL="https://console.multitenant.galileocloud.io"
# Optional: override project / log stream (defaults: default / default).
# GALILEO_PROJECT="Workshop19Galileo"
# GALILEO_LOG_STREAM="TravelPlanner"
